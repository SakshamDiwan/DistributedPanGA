# Build artifacts
*.o
*.a
*.so
*.d

# Binaries — compiled per-machine, never check in
distributedpanga
pga-extract
pga-sort
pga-mpi-stage1
pga-mpi
pga-merge
pga-merge-dbg
pga-mpi-merge
test_contig_assignment

